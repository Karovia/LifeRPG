pageType: content
background:
  type: image
  src: assets/背景/bg-parchment.png
  fit: {mode: cover}
notes: 功能① AI 成就树：目标拆解为 20+ 小步任务节点，联网搜索真实参考，每步带 deadline 与验收标准
elements:
  - elementId: hdr-brand
    elementType: text
    bounds: [48, 22, 240, 16]
    content:
      style: "$pixelLabel"
      align: [left, middle]
      wrap: false
      text: ZHIJIAN · LIFE RPG
  - elementId: hdr-page
    elementType: text
    bounds: [792, 22, 120, 16]
    content:
      style: "$pixelLabel"
      align: [right, middle]
      wrap: false
      text: 05 / 09
  - elementId: title
    elementType: text
    bounds: [48, 50, 760, 42]
    content:
      style: "$pageTitle"
      align: [left, middle]
      wrap: false
      text: 功能 ① · AI 成就树
  - elementId: title-tick
    elementType: shape
    bounds: [50, 100, 72, 5]
    shapeName: rect
    fill: {type: solid, color: "$gold"}
  # 左侧：图标 + 大数字 + 要点
  - elementId: feat-icon
    elementType: image
    bounds: [48, 136, 56, 56]
    src: assets/图标/icon-star.png
    fit: {mode: fill}
  - elementId: big-num
    elementType: text
    bounds: [48, 200, 130, 48]
    content:
      fontFamily: Jersey15
      fontSize: 40
      color: "$gold"
      align: [left, middle]
      wrap: false
      text: 20+
  - elementId: big-num-label
    elementType: text
    bounds: [152, 214, 180, 22]
    content:
      fontSize: 13
      color: "$ink"
      fontFamily: MiSans
      align: [left, middle]
      wrap: false
      text: 个小步任务节点
  - elementId: feat-list
    elementType: text
    bounds: [48, 268, 400, 124]
    content:
      style: "$body"
      lineHeight: 2.0
      align: [left, top]
      text: |
        <p><span style="color:$berry">▸</span> 输入人生目标：升学、技能、作品集……</p>
        <p><span style="color:$berry">▸</span> AI 联网搜索真实参考，大模型拆解任务</p>
        <p><span style="color:$berry">▸</span> 每步带 deadline 与验收标准</p>
        <p><span style="color:$berry">▸</span> 像游戏任务一样，一步步点亮成就树</p>
  # 右侧：节点树（形状绘制）
  - elementId: tree-star
    elementType: image
    bounds: [548, 148, 32, 32]
    src: assets/图标/icon-star.png
    fit: {mode: fill}
  - elementId: tree-root
    elementType: shape
    bounds: [586, 140, 200, 44]
    shapeName: rect
    fill: {type: solid, color: "$paper"}
    border: {style: solid, width: 2, color: "$ink"}
  - elementId: tree-root-text
    elementType: text
    bounds: [586, 140, 200, 44]
    content: {fontSize: 15, color: "$ink", fontFamily: 精品点阵体, align: [center, middle], wrap: false, text: 人生目标}
  # 连接线
  - elementId: link-trunk
    elementType: shape
    bounds: [685, 184, 2, 31]
    shapeName: rect
    fill: {type: solid, color: "$wood"}
  - elementId: link-bar
