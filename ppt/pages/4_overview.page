pageType: content
background:
  type: image
  src: assets/背景/bg-sky-clouds.png
  fit: {mode: cover}
notes: 功能总览：5 大核心功能导览——成就树 / 魔法日记 / 职见小镇 / 冒险面板 / 自动简历
elements:
  - elementId: hdr-brand
    elementType: text
    bounds: [48, 22, 240, 16]
    content:
      style: "$pixelLabel"
      align: [left, middle]
      wrap: false
      text: ZHIJIAN · LIFE RPG
  - elementId: hdr-page
    elementType: text
    bounds: [792, 22, 120, 16]
    content:
      style: "$pixelLabel"
      align: [right, middle]
      wrap: false
      text: 04 / 09
  - elementId: title
    elementType: text
    bounds: [48, 50, 760, 42]
    content:
      style: "$pageTitle"
      align: [left, middle]
      wrap: false
      text: 五大核心功能 · 冒险地图
  - elementId: title-tick
    elementType: shape
    bounds: [50, 100, 72, 5]
    shapeName: rect
    fill: {type: solid, color: "$gold"}
  # 卡片 1 成就树
  - elementId: c1-bg
    elementType: shape
    bounds: [40, 172, 160, 264]
    shapeName: rect
    fill: {type: solid, color: "$paper"}
    border: {style: solid, width: 2, color: "$ink"}
  - elementId: c1-num
    elementType: text
    bounds: [40, 186, 160, 20]
    content: {fontFamily: Jersey15, fontSize: 15, color: "$gold", letterSpacing: 4, align: [center, middle], wrap: false, text: "01"}
  - elementId: c1-icon
    elementType: image
    bounds: [88, 218, 64, 64]
    src: assets/图标/icon-star.png
    fit: {mode: fill}
  - elementId: c1-name
    elementType: text
    bounds: [46, 296, 148, 26]
    content: {fontSize: 16, color: "$ink", fontFamily: 精品点阵体, align: [center, middle], wrap: false, text: 成就树}
  - elementId: c1-desc
    elementType: text
    bounds: [50, 330, 140, 72]
    content:
      fontSize: 10
      color: "$wood"
      fontFamily: MiSans
      lineHeight: 1.7
      align: [center, top]
      text: |
        AI 联网拆解目标
        20+ 小步任务节点
  # 卡片 2 魔法日记
