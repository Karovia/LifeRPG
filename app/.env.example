# Pixellab API key (https://www.pixellab.ai) — 复制本文件为 .env 并填入真实 key
VITE_PIXELLAB_API_KEY=your-pixellab-api-key

# 阶跃星辰 LLM 默认配置（OpenAI 兼容，/admin 页可覆盖）
VITE_LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
VITE_LLM_API_KEY=your-stepfun-api-key
VITE_LLM_MODEL=step-3.5-flash-2603

# ============================================================
# 生产部署（Vercel）专用
# ============================================================
# Server mode：构建期置 true 后，前端不再内置/要求任何 LLM 密钥，
# enabled 默认 true；/api/llm 与 /api/decompose 的请求由服务端
# function 注入下方 LLM_* 环境变量。Admin 页手填配置仍可覆盖。
VITE_LLM_SERVER_MODE=false

# 服务端（Vercel Functions）环境变量 —— 仅存在于服务端，不进前端产物。
# 在 Vercel 项目 Settings → Environment Variables 中配置；
# 本地用 `vercel dev` 调试 functions 时可填入 .env（无 VITE_ 前缀，不会暴露给前端）。
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=your-stepfun-api-key
LLM_MODEL=step-3.5-flash-2603
PIXELLAB_API_KEY=your-pixellab-api-key
